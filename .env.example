# Copy to .env for local development. Never commit the real file.
DEBUG=True
SECRET_KEY=change-me
# Neon: Project "retro-book-store" → Connect → pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
TIME_ZONE=Asia/Dhaka
CURRENCY_SYMBOL=$
# Optional SMTP (console backend is used when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: Neon Object Storage for uploaded covers (S3-compatible)
AWS_STORAGE_BUCKET_NAME=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Protects /cron/circulation-sweep/ (sent as "Authorization: Bearer <secret>")
CRON_SECRET=
